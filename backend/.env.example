APP_NAME=BRAVE AI API
ENVIRONMENT=development
API_PREFIX=/api

DATABASE_URL=postgresql+asyncpg://brave:brave_password@localhost:5432/brave_ai
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.110.211:3000"]
MEDIA_BASE_URL=http://localhost:8000/media
MEDIA_HLS_BASE_URL=http://localhost:8888
MEDIA_HLS_PROBE_BASE_URL=http://localhost:8888
MEDIA_PROBE_TIMEOUT_SECONDS=5
MEDIA_RECORDINGS_DIR=/recordings
MEDIA_RECORD_SEGMENT_DURATION_SECONDS=60
MEDIA_RECORD_MIN_FILE_SIZE_BYTES=65536
MEDIA_ARCHIVE_DIR=/archives
RECORDING_SESSION_DURATION_SECONDS=86400
RECORDING_ARCHIVE_RETENTION_DAYS=7
RECORDING_ARCHIVE_POLL_SECONDS=60
RECORDING_ARCHIVE_GAP_TOLERANCE_SECONDS=10
RECORDING_ARCHIVE_OUTPUT_DURATION_TOLERANCE_SECONDS=10
RECORDING_ARCHIVE_FFMPEG_TIMEOUT_SECONDS=21600
RECORDING_ARCHIVE_VIDEO_CRF=30
RECORDING_ARCHIVE_VIDEO_FPS=12
RECORDING_ARCHIVE_VIDEO_PRESET=veryfast
RECORDING_ARCHIVE_VIDEO_MAX_WIDTH=960
RECORDING_ARCHIVE_VIDEO_MAX_HEIGHT=540
RECORDING_ARCHIVE_VIDEO_MAX_BITRATE_KBPS=900
RECORDING_ARCHIVE_AUDIO_BITRATE_KBPS=48
MEDIA_CLIPS_DIR=/clips
EVIDENCE_CLIP_MAX_DURATION_SECONDS=600
EVIDENCE_CLIP_FFMPEG_TIMEOUT_SECONDS=180
EVIDENCE_CLIP_SOURCE_WAIT_SECONDS=120
EVIDENCE_CLIP_GAP_TOLERANCE_SECONDS=1
EVIDENCE_CLIP_OUTPUT_DURATION_TOLERANCE_SECONDS=2
EVIDENCE_CLIP_RETENTION_DAYS=7
EVIDENCE_CLIP_CLEANUP_POLL_SECONDS=3600
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

# Klasifikasi video terpusat (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VIDEO_FPS=5
GEMINI_INLINE_MAX_BYTES=18874368
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=1
AI_DETECTION_ENABLED=false
AI_DETECTION_CLIP_SECONDS=6
AI_DETECTION_INTERVAL_SECONDS=6
AI_DETECTION_CONFIDENCE_THRESHOLD=0.80
AI_DETECTION_COOLDOWN_SECONDS=30
AI_DETECTION_CAMERA_REFRESH_SECONDS=15
AI_DETECTION_QUEUE_SIZE=3
AI_DETECTION_MAX_CONCURRENCY=3
AI_DETECTION_MAX_CLIP_AGE_SECONDS=45
AI_DETECTION_FRAME_WIDTH=480
AI_DETECTION_RTSP_BASE_URL=rtsp://mediamtx:8554
AI_DETECTION_CAPTURE_TIMEOUT_SECONDS=20
INCIDENT_API_BASE_URL=http://api:8000/api
INCIDENT_REQUEST_TIMEOUT_SECONDS=10
INCIDENT_REQUEST_MAX_ATTEMPTS=4
INCIDENT_REQUEST_RETRY_BASE_SECONDS=0.5
INCIDENT_INGEST_TOKEN=

# Offline Gemini dataset evaluation (does not create production incidents).
AI_EVALUATION_DATASET_DIR=datasets/brave-ai
AI_EVALUATION_REPORT_DIR=docs/ai-evaluation
AI_EVALUATION_ANNOTATIONS_FILE=
AI_EVALUATION_CONCURRENCY=1
AI_EVALUATION_THRESHOLD=0.75
SECRET_KEY=change-this-development-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=brave_session
SEED_ADMIN_EMAIL=admin@braveai.school
SEED_ADMIN_PASSWORD=password
SEED_VIEWER_EMAIL=gurubk@braveai.school
SEED_VIEWER_PASSWORD=password
