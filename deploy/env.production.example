# Copy this file to /opt/brave-ai-cctv/.env.production on the VPS.
APP_HOST=brave-ai.web.id
POSTGRES_PASSWORD=change-this-long-random-password
SECRET_KEY=change-this-long-random-secret-key
INCIDENT_INGEST_TOKEN=change-this-long-random-ingest-token
ADMIN_PASSWORD=change-this-admin-password
VIEWER_PASSWORD=change-this-guru-bk-password

# Arsip per sesi: selesai saat kamera berhenti atau maksimal setiap 24 jam.
RECORDING_SESSION_DURATION_SECONDS=86400
RECORDING_ARCHIVE_RETENTION_DAYS=7
RECORDING_ARCHIVE_GAP_TOLERANCE_SECONDS=10
RECORDING_ARCHIVE_OUTPUT_DURATION_TOLERANCE_SECONDS=10
RECORDING_ARCHIVE_VIDEO_CRF=30
RECORDING_ARCHIVE_VIDEO_FPS=12
RECORDING_ARCHIVE_VIDEO_MAX_WIDTH=960
RECORDING_ARCHIVE_VIDEO_MAX_HEIGHT=540
RECORDING_ARCHIVE_VIDEO_MAX_BITRATE_KBPS=900
EVIDENCE_CLIP_RETENTION_DAYS=7
EVIDENCE_CLIP_CLEANUP_POLL_SECONDS=3600

# Keep false until MediaMTX camera publishing is stable and the Gemini key is set.
AI_DETECTION_ENABLED=false
GEMINI_API_KEY=replace-with-server-side-gemini-api-key
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_VIDEO_FPS=10
AI_DETECTION_INTERVAL_SECONDS=3
AI_DETECTION_CONFIDENCE_THRESHOLD=0.75
AI_DETECTION_COOLDOWN_SECONDS=30
AI_DETECTION_MAX_CONCURRENCY=1
INCIDENT_REQUEST_MAX_ATTEMPTS=4
INCIDENT_REQUEST_RETRY_BASE_SECONDS=0.5
